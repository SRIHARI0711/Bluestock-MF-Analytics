{
  "name": "Bluestock Fintech Theme",
  "dataColors": [
    "#0066FF",
    "#00D4B2",
    "#0A2540",
    "#6366F1",
    "#F59E0B",
    "#10B981",
    "#EF4444",
    "#8B5CF6",
    "#3B82F6",
    "#14B8A6"
  ],
  "background": "#F4F6F9",
  "foreground": "#0A2540",
  "tableAccent": "#0066FF",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#0A2540"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0066FF"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}